# Database
DATABASE_URL="file:./prisma/dev.db"

# JWT (generate a strong secret with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="1h"

# IP Hash Pepper (generate with: openssl rand -base64 32)
IP_HASH_PEPPER="another-random-string-change-in-production"

# Initial Users (set on first run - CHANGE THESE PASSWORDS)
INITIAL_AUDITOR_USER="auditor"
INITIAL_AUDITOR_PASS="changeme123"
INITIAL_CEO_USER="ceo"
INITIAL_CEO_PASS="changeme123"

# Server
PORT=3001
NODE_ENV="development"

# CORS (frontend URL)
CORS_ORIGIN="http://localhost:5173"
